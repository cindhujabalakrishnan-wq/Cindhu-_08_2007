# Copy this file to .env (root) for local dev, or export the variables in your shell.
# Backend reads these via backend/src/main/resources/application*.yml.
# Frontend reads VITE_* via frontend/.env.example -> frontend/.env.

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Database (MySQL 8). Dev default: jdbc:mysql://localhost:3306/insurance_dev
DB_URL=jdbc:mysql://localhost:3306/insurance_dev?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Auth (JWT). Use a long random 256-bit+ secret in production.
JWT_SECRET=change-me-to-a-256-bit-secret-for-local-dev-only-0123456789abcdef
JWT_EXPIRATION=86400000

# Seeded admin user (created on startup when SEED_ADMIN=true)
ADMIN_EMAIL=admin@insurance.local
ADMIN_PASSWORD=Admin@123
SEED_ADMIN=true

# Local file storage for policy documents
FILE_STORAGE_PATH=./uploads
APP_FILE_MAX_SIZE=10MB

# Mail (dev default points at a local MailHog/Mailpit on port 1025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@insurance.local

# Frontend origin (Vite dev server runs on http://localhost:5173)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Renewal reminder scheduler cron (8 AM daily by default)
SCHEDULER_CRON=0 0 8 * * *

# Frontend -> backend base URL (frontend appends /api; backend serves /api/v1/* on port 8080)
VITE_API_BASE_URL=http://localhost:8080
